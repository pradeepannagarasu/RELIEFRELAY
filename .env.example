# Copy to .env and adjust. Never commit real secrets.

# API server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Payment provider mode.
#   simulation : no external requests; all provider events are synthetic and labelled as such.
#                Payment actions are disabled.
#   sandbox    : PayPal Payouts Sandbox, test money only. Needs a PayPal Sandbox app's credentials below.
PAYMENT_PROVIDER_MODE=simulation

# PayPal Sandbox credentials (server-side only). Use a Sandbox app from developer.paypal.com, never a live app.
# Put them only in this .env file: never in chat, code, tickets or commits.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Only the PayPal Sandbox API is accepted; live PayPal hosts are refused at startup.
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# Server-side switch for payment actions. Proposals cannot be approved while this is false.
PAYPAL_PAYOUTS_ENABLED=false
# ID of the webhook registered on the Sandbox app. Leave empty to rely on polling only (listener off).
PAYPAL_WEBHOOK_ID=
# Port of the separate webhook listener (path /paypal/webhooks). Expose it with an HTTPS tunnel for PayPal.
PAYPAL_WEBHOOK_PORT=4001
# Development only: write each raw webhook delivery here, to build the genuine verification fixture.
# Keep it inside server/data/ so captures are never committed.
PAYPAL_WEBHOOK_CAPTURE_DIR=
# How often submitted payouts are re-read from PayPal Sandbox, 5000 to 3600000.
PAYPAL_POLL_INTERVAL_MS=30000

# Development only: shows a "Role demo (not sign-in)" switcher between the seeded demo users.
# It is not authentication and is refused when NODE_ENV is not development.
DEMO_ROLE_SWITCHER=false

# OpenAI, for AI-assisted investigation (server-side only).
# Leave OPENAI_API_KEY empty to disable the feature; nothing is then sent anywhere.
# Only ever use a key with synthetic data. Requests use store: false, but OpenAI may still retain
# them for up to 30 days for abuse monitoring unless Zero Data Retention is enabled for your organisation.
OPENAI_API_KEY=
# Defaults to gpt-6.1-sol.
OPENAI_MODEL=
# Must be HTTPS; plain HTTP is accepted only for loopback addresses.
OPENAI_BASE_URL=https://api.openai.com/v1
# low, medium or high.
OPENAI_REASONING_EFFORT=medium
# Whole-call timeout including the single retry, 5000 to 120000.
AI_TIMEOUT_MS=45000
# Output token cap per investigation (reasoning tokens count towards it), 1000 to 32000.
AI_MAX_OUTPUT_TOKENS=8000
# Investigation attempts per organisation per UTC day, including failed attempts.
AI_DAILY_INVESTIGATION_LIMIT=50

# SQLite database file, relative to the project root. Never commit it.
# In development an empty database is seeded with synthetic demo data on startup; production is never seeded automatically.
DATABASE_PATH=server/data/reliefrelay.db
