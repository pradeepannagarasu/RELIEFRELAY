{
  "name": "reliefrelay",
  "version": "0.1.0",
  "private": true,
  "description": "Humanitarian payment recovery platform: reconcile, investigate and resolve failed, returned, held and unclaimed payouts with human-authorised recovery and a complete audit trail.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --tsconfig server/tsconfig.json server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run typecheck && vite build --config web/vite.config.ts",
    "start": "tsx --tsconfig server/tsconfig.json server/src/index.ts",
    "demo:public-gateway": "tsx --tsconfig server/tsconfig.json server/src/publicDemo/gateway.ts",
    "demo:judge": "tsx --tsconfig server/tsconfig.json server/src/judgeDemo/server.ts",
    "demo:judge:reset": "tsx --tsconfig server/tsconfig.json server/src/judgeDemo/server.ts --reset",
    "typecheck": "tsc -p shared/tsconfig.json && tsc -p server/tsconfig.json && tsc -p web/tsconfig.json && tsc -p tsconfig.tooling.json && tsc -p cloud/tsconfig.json",
    "db:migrate": "tsx --tsconfig server/tsconfig.json server/src/db/cli.ts migrate",
    "db:seed": "tsx --tsconfig server/tsconfig.json server/src/db/cli.ts seed",
    "db:reset": "tsx --tsconfig server/tsconfig.json server/src/db/cli.ts reset",
    "db:verify-audit": "tsx --tsconfig server/tsconfig.json server/src/db/cli.ts verify-audit",
    "ai:smoke": "tsx --tsconfig server/tsconfig.json server/src/ai/smoke.ts",
    "paypal:receivers": "tsx --tsconfig server/tsconfig.json server/src/paypal/cli.ts receivers",
    "paypal:sandbox-check": "tsx --tsconfig server/tsconfig.json server/src/paypal/cli.ts sandbox-check",
    "paypal:webhook-fixture": "tsx --tsconfig server/tsconfig.json server/src/paypal/cli.ts webhook-fixture",
    "sandbox:demo-scenario": "tsx --tsconfig server/tsconfig.json server/src/paypal/cli.ts demo-scenario",
    "demo:local-stub": "concurrently -k -n stub-demo,web -c yellow,cyan \"tsx --tsconfig server/tsconfig.json server/src/paypal/localStubDemo.ts\" \"npm:dev:web\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "cloud:build": "npm run build && tsx --tsconfig server/tsconfig.json cloud/scripts/write-headers.ts",
    "cloud:dev": "wrangler dev --config cloud/wrangler.jsonc --var ENFORCE_HTTPS:false",
    "cloud:deploy": "wrangler deploy --config cloud/wrangler.jsonc",
    "cloud:migrate-data": "tsx --tsconfig server/tsconfig.json cloud/scripts/migrate-judge-demo.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^7.0.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.71.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.7",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  }
}
